# Amberite Core — required environment variables
# Copy this file to .env.local for debug builds or .env.prod for release builds.

# ── Storage ───────────────────────────────────────────────────────────────────
# Root directory for all instance data.
CORE_DATA_DIR=

# ── HTTP ──────────────────────────────────────────────────────────────────────
# Port the Core API listens on.
PORT=

# Host/IP the Core API binds to. Set to 0.0.0.0 only when exposing Core to LAN or the public internet.
AMBERITE_BIND_HOST=

# Allowed CORS origin.
ALLOWED_ORIGIN=

# Optional. Public address clients use to reach this Core, for example https://core.example.com.
# Leave empty to use this machine's network address and PORT. Must be HTTPS unless it is on this
# computer or a private network.
AMBERITE_PUBLIC_URL=

# ── Accounts ──────────────────────────────────────────────────────────────────
# Backend that owns accounts. Core asks it who an account token belongs to.
ACCOUNT_API_URL=
