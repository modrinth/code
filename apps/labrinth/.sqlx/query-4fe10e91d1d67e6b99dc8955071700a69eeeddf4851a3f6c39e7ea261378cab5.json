{
  "db_name": "PostgreSQL",
  "query": "\n                SELECT\n                    m.id AS \"id!\",\n                    m.review_status AS \"review_status!: ProjectReviewStatus\",\n                    m.slug,\n                    t.id AS \"thread_id!\"\n                FROM mods m\n                INNER JOIN team_members tm\n                    ON tm.team_id = m.team_id\n                    AND tm.user_id = $1\n                    AND tm.is_owner = TRUE\n                INNER JOIN threads t ON t.mod_id = m.id\n                ",
