{
  "db_name": "PostgreSQL",
  "query": "\n            INSERT INTO delphi_reports (file_id, delphi_version, artifact_url, severity)\n            VALUES ($1, $2, $3, $4)\n            ON CONFLICT (file_id, delphi_version) DO UPDATE SET\n                artifact_url = $3, created = CURRENT_TIMESTAMP, severity = $4\n            RETURNING id\n            ",
  "describe": {
    "columns": [
