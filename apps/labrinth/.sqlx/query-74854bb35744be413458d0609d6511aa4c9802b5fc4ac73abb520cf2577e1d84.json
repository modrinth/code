  "query": "\n                    SELECT id, user_id, session, created, last_login, expires, refresh_expires, os, platform,\n                    city, country, ip, user_agent\n                    FROM sessions\n                    WHERE id = ANY($1) OR session = ANY($2)\n                    ORDER BY created DESC\n                    ",
