  "query": "\n        SELECT\n            files.url,\n            files.filename,\n            files.size,\n            files.version_id AS \"version_id: DBVersionId\",\n            versions.mod_id AS \"project_id: DBProjectId\"\n        FROM files INNER JOIN versions ON files.version_id = versions.id\n        WHERE files.id = $1\n        ",
