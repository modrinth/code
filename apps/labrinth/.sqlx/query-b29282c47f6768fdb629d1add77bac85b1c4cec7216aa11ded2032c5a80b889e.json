  "db_name": "PostgreSQL",
  "query": "\n        SELECT v.mod_id AS project_id, f.id, f.version_id, f.filename, f.url, f.size\n        FROM files f\n        INNER JOIN versions v ON v.id = f.version_id\n        WHERE v.mod_id = ANY($1)\n        ORDER BY v.mod_id, v.date_published DESC, v.id DESC, f.id\n        ",
