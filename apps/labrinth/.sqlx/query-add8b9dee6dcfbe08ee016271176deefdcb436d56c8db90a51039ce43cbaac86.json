  "query": "\n        SELECT DISTINCT ON (file_id)\n            id AS \"report_id!: DelphiReportId\",\n            file_id AS \"file_id!: DBFileId\",\n            created,\n            severity AS \"severity!: DelphiSeverity\"\n        FROM delphi_reports\n        WHERE\n            file_id IS NOT NULL\n            AND file_id = ANY($1::bigint[])\n        ORDER BY file_id, delphi_version DESC\n        ",
