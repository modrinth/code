  "db_name": "PostgreSQL",
  "query": "\n                    SELECT DISTINCT mod_id, v.id as id, date_published,\n                        v.components AS \"components: sqlx::types::Json<exp::VersionSerial>\"\n                    FROM mods m\n                    INNER JOIN versions v ON m.id = v.mod_id AND v.status = ANY($3)\n                    WHERE m.id = ANY($1) OR m.slug = ANY($2)\n                    ",
