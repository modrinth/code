# ==============================================
# OWYX PROJECT - Environment Variables
# ==============================================
# cp .env.example .env

# ----------------------------------------------
# PostgreSQL Database
# ----------------------------------------------
DB_USER=owyx_user
DB_PASSWORD=your_secure_password_here_change_me
DB_NAME=owyx_db
DB_HOST=127.0.0.1
DB_PORT=5432

# ----------------------------------------------
# Directus CMS (optional / legacy)
# ----------------------------------------------
DIRECTUS_KEY=generate_random_key_here_32_bytes
DIRECTUS_SECRET=generate_random_secret_here_32_bytes
ADMIN_EMAIL=admin@owyx.site
ADMIN_PASSWORD=your_admin_password_here
DIRECTUS_ADMIN_TOKEN=

# ----------------------------------------------
# Backend API (Express + Socket.io)
# ----------------------------------------------
API_PORT=3001
PORT=3001
FRONTEND_PORT=3000
FRONTEND_BIND=0.0.0.0
API_BIND=0.0.0.0
POSTGRES_BIND=0.0.0.0
ADMINER_PORT=8080
ADMINER_BIND=0.0.0.0
JWT_SECRET=generate_random_jwt_secret_here
SESSION_SECRET=generate_random_session_secret_here

# Launcher → https://api.owyx.site must send header X-Owyx-Client-Key
# matching this value. Browser traffic via https://owyx.site/api does NOT
# need the key (Host is owyx.site). Required in production.
LAUNCHER_CLIENT_KEY=generate_long_random_hex_here
API_HOSTS=api.owyx.site

# Cloudflare Turnstile (leave empty / TURNSTILE_SKIP=true for local)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_SKIP=true
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Discord OAuth (optional)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ----------------------------------------------
# Email (SMTP / Resend SMTP)
# ----------------------------------------------
EMAIL_FROM=noreply@owyx.site
EMAIL_TRANSPORT=smtp
EMAIL_SMTP_HOST=smtp.yandex.ru
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# ----------------------------------------------
# Domain & URLs (OBT / prod)
# ----------------------------------------------
# Website
PUBLIC_URL=https://owyx.site
FRONTEND_URL=https://owyx.site
CORS_ORIGIN=https://owyx.site,https://www.owyx.site,http://localhost:3000
# Launcher API origin (absolute URLs for packs/skins returned to clients)
API_PUBLIC_URL=https://api.owyx.site
API_URL=https://api.owyx.site/api
TRUST_PROXY_HOPS=0

# Browser-facing (prefer same-origin /api on owyx.site — leave empty or site path)
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_DIRECTUS_URL=
NEXT_PUBLIC_SOCKET_URL=

# Server-side rewrite target for Next.js (docker compose sets this)
BACKEND_URL=http://127.0.0.1:3001

# ----------------------------------------------
# FRP (game traffic — separate from this VPS)
# ----------------------------------------------
FRP_SERVER_ADDR=45.131.186.146
FRP_SERVER_PORT=7000
FRP_TOKEN=your_frp_secret_token_here

# Public Minecraft join address (FRPC share on RU VPS → MiniPC)
# Format host:port for friends / site settings seed
OWYX_PLAY_ADDRESS=45.131.186.146:1488

# ----------------------------------------------
# Minecraft Integration (optional)
# ----------------------------------------------
