# Launcher ↔ Owyx site (local / OBT)
#
# API base (prod default in Rust is https://api.owyx.site)
# Empty = use compiled default.
OWYX_API_BASE_URL=

# Must match owyxsite LAUNCHER_CLIENT_KEY when talking to api.owyx.site.
# Also readable from %USERPROFILE%/owyx/client_key (one line).
OWYX_CLIENT_KEY=
